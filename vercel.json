{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run migrate:schema && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "regions": ["sin1"],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/dispatch?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
