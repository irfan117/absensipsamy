# TiDB split configuration: use these instead of DATABASE_URL when possible.
TIDB_HOST=your-cluster-host
TIDB_PORT=4000
TIDB_USER=your-database-user
TIDB_PASSWORD=your-database-password
TIDB_DATABASE=absensi_db

# Required for production authentication.
JWT_SECRET=replace-with-a-long-random-secret

# Optional integrations / deployment routing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use the exact frontend origin if the frontend and API are on different origins.
CLIENT_ORIGIN=https://your-project.vercel.app
# Leave empty on Vercel when the frontend and /api share one domain.
# Do not set this to localhost in Production/Preview.
VITE_API_URL=
